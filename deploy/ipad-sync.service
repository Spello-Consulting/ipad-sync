# Systemd service file for Tool to sync an Apple TV playlist to the Infuse app
[Unit]
Description=Tool to sync an Apple TV playlist to the Infuse app
After=network.target
StartLimitIntervalSec=20
StartLimitBurst=5

[Service]
User=nick
ExecStart=/home/nick/scripts/ipad-sync/scripts/launch.sh
WorkingDirectory=/home/nick/scripts/ipad-sync
StandardOutput=inherit
StandardError=inherit
EnvironmentFile=/home/nick/.config/op/service-account-token
Environment=PATH=/home/nick/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Only restart on non-zero exit code
Restart=on-failure
# Wait 10 seconds before restarting
RestartSec=10

[Install]
WantedBy=multi-user.target
